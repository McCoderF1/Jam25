<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
	  <LangVersion>13.0</LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Content\Images\NewFolder\**" />
    <Compile Remove="Content\Sound\**" />
    <Compile Remove="ScreenManager\**" />
    <EmbeddedResource Remove="Content\Images\NewFolder\**" />
    <EmbeddedResource Remove="Content\Sound\**" />
    <EmbeddedResource Remove="ScreenManager\**" />
    <None Remove="Content\Images\NewFolder\**" />
    <None Remove="Content\Sound\**" />
    <None Remove="ScreenManager\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="**\*.ms" />
    <AdditionalFiles Include="**\*.ms" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Remove="Content\Images\NewFolder\**" />
    <AdditionalFiles Remove="Content\Sound\**" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.1.303" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Stores\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Jam25\HDT.Gaming\HDT.Gaming\HDT.Gaming.csproj" />
  </ItemGroup>
  <Target Name="RestoreDotnetTools" BeforeTargets="Restore">
    <Message Text="Restoring dotnet tools" Importance="High" />
    <Exec Command="dotnet tool restore" />
  </Target>
</Project>